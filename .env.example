# Next.js: Clerk API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex deployment URLs (from the Convex dashboard / pnpm exec convex dev)
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Local Convex CLI deployment selector (written by pnpm exec convex dev)
CONVEX_DEPLOYMENT=

# Set this ON THE CONVEX DEPLOYMENT, not just in .env.local:
# pnpm exec convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
# Use the Clerk Frontend API URL; enable Clerk's Convex integration.
